# Central operator template for compose.coolify.yaml. Never overwrite an existing .env.
# Set secrets in Coolify as runtime-only, not build variables. Real values stay out of Git.
# REQUIRED Go Telegram account/source configuration. No test or production defaults.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE=
USER_NAME=
# TELEGRAM_SOURCE = exact accessible group/channel display title (Unicode allowed).
# USER_NAME = the Telegram account's primary username, not the administrator display name.

# REQUIRED existing external PostgreSQL connection. Keep the existing database/data.
DATA_BASE_URL=
# Optional direct/migration-role URL for this SAME database; never an unrelated empty database.
DATA_BASE_DIRECT_URL=
DATABASE_POOL_MAX=4

# REQUIRED independent random service secrets, >=32 characters each.
STREAM_SERVICE_TOKEN=
API_GATEWAY_TOKEN=
# REQUIRED chosen hostname only: no scheme, path or internal port.
# HTTPS must be available before real login/playback. Default sslip.io URLs are HTTP-only.
PUBLIC_HOST=

# REQUIRED production pk_live_/sk_live_ keys from the existing Clerk application.
CLERK_PUBLIC_KEY=
CLERK_SECRET_KEY=
# Optional existing alias if CLERK_PUBLIC_KEY is not used.
CLERK_PUBLISHABLE_KEY=
# Optional PEM public verification key; a server secret key is still required for identity lookup.
CLERK_JWT_KEY=
# One-time first OWNER approval only when the selected database has no administrators.
# Existing identities/roles are preserved. USER_NAME is not an OWNER-name setting.
EMAIL=

# REQUIRED absolute HOST paths to the existing matching RSA PEM pair.
# Private key: readable by API UID 1000 only. Public key: readable by Go UID 10001 too.
PLAYBACK_PRIVATE_KEY_PATH=
PLAYBACK_PUBLIC_KEY_PATH=
# Optional host path to previous PUBLIC keys JSON. Empty uses the supplied empty key ring.
PLAYBACK_PREVIOUS_KEYS_PATH=
PLAYBACK_KEY_ID=
PLAYBACK_GRANT_TTL_SECONDS=300
PLAYBACK_ISSUER=habeshan-hub
PLAYBACK_AUDIENCE=habeshan-stream
PLAYBACK_CLOCK_TOLERANCE_SECONDS=30
PLAYBACK_CLOCK_TOLERANCE=30s
PLAYBACK_CHECK_INTERVAL=15s
PLAYBACK_SESSION_UPSTREAM_LIMIT=1
PLAYBACK_DRAIN=0

# Go volume filenames. Keep under /sessions and /state unless mounts are deliberately changed.
TELEGRAM_SESSION_PATH=/sessions/telegram.session.json
CATALOGUE_PATH=/state/catalogue.json
SYNC_INTERVAL=30s
MEMBERSHIP_CURRENCY=ETB
APP_TIMEZONE=Africa/Nairobi
TELEGRAM_SUPPORT_USERNAME=

# Compose supplies API_HOST/API_PORT, STREAM_LISTEN, STREAM_ORIGIN, PUBLIC_ORIGIN,
# ADMIN_ORIGIN and PLAYBACK_CHECK_URL internally. Frontends need no build-time env.
# FFMPEG_PATH is optional for native/local API use; the API image installs ffmpeg on PATH.
# No global viewer/upstream caps, default CPU/RAM quotas or production stream throttle.
# Optional explicit quotas: enable compose.resources.yaml and set its eight HUB_* variables.
# Optional quota inputs; leave commented unless compose.resources.yaml is explicitly enabled.
# HUB_API_CPUS=
# HUB_API_MEMORY=
# HUB_GO_CPUS=
# HUB_GO_MEMORY=
# HUB_WEB_CPUS=
# HUB_WEB_MEMORY=
# HUB_PROXY_CPUS=
# HUB_PROXY_MEMORY=
# Optional local backup-test binary directory, matching the database server major:
# POSTGRES_BIN=
