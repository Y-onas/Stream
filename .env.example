# Server-side only. Never prefix these with VITE_.
TELEGRAM_API_ID=your_numeric_api_id
TELEGRAM_API_HASH=your_32_character_hex_api_hash
DATA_BASE_URL=postgresql://user:password@database-host:5432/database
# Optional direct endpoint for migrations; Neon pooled URLs are converted automatically.
DATA_BASE_DIRECT_URL=

# Managed runtime / production. Use independent random values, never VITE_ variables.
TELEGRAM_SOURCE=Stream Test
STREAM_SERVICE_TOKEN=replace_with_at_least_32_random_characters
API_GATEWAY_TOKEN=replace_with_another_32_random_characters
PUBLIC_HOST=your-domain.example
# Legacy operator-gate settings are no longer required; public browsing is anonymous.
SYNC_INTERVAL=30s
MEMBERSHIP_CURRENCY=ETB
APP_TIMEZONE=Africa/Nairobi
DATABASE_POOL_MAX=8
# Human Telegram account only; a numeric Telegram ID is not a public chat URL.
TELEGRAM_SUPPORT_USERNAME=
# Configure Google as the Clerk application's sign-in provider.
CLERK_PUBLIC_KEY=
# Legacy CLERK_PUBLISHABLE_KEY remains an optional alias.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# One-time first owner bootstrap. Later administrator approvals are database-only.
EMAIL=
USER_NAME=
# Local admin frontend; in production set the public HTTPS site origin.
ADMIN_ORIGIN=http://127.0.0.1:5174
# Optional executable override for video frame previews. Default: ffmpeg on PATH.
# Local runtime also detects .tools/ffmpeg/bin/ffmpeg.exe on Windows.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe

# Module 4.3: server-only RS256 keys; generate locally with node scripts/playback-keys.mjs.
PLAYBACK_PRIVATE_KEY_PATH=/absolute/private/path/playback-private.pem
PLAYBACK_PUBLIC_KEY_PATH=/absolute/private/path/playback-public.pem
PLAYBACK_GRANT_TTL_SECONDS=300
PLAYBACK_ISSUER=habeshan-hub
PLAYBACK_AUDIENCE=habeshan-stream
# Private Go-to-Node lease checks; never expose this endpoint publicly.
PLAYBACK_CHECK_URL=http://api:3000/internal/playback/check
PLAYBACK_CHECK_INTERVAL=15s
