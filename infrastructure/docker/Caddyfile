{$PUBLIC_HOST} {
  @adminPages path /hub-console /hub-console/*
  header @adminPages X-Robots-Tag "noindex, nofollow, noarchive"
  # Public browsing is anonymous. Account and admin routes authorize in Node.
  log {
    output stdout
    format filter {
      wrap json
      fields {
        # OAuth callbacks can carry tickets in URLs or referrers.
        request>uri delete
        request>headers delete
        resp_headers delete
      }
    }
  }
  @api path /api/*
  handle /readyz {
    rewrite * /healthz
    reverse_proxy api:3000
  }
  handle @api {
    reverse_proxy api:3000 {
      header_up X-Gateway-Token {$API_GATEWAY_TOKEN}
      header_up X-Client-IP {remote_host}
      # The public client cannot supply a trusted internal playback header.
      header_up -X-Playback-Grant
      flush_interval -1
    }
  }
  @legacyAdmin path /admin /admin/*
  handle @legacyAdmin {
    respond "Not found." 404
  }
  handle {
    reverse_proxy web:80
  }
}
