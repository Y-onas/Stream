{$PUBLIC_HOST} {
  # Public browsing is anonymous. Account and admin routes authorize in Node.
  log {
    output stdout
    format filter {
      wrap json
      fields {
        request>headers>Cookie delete
        request>headers>Authorization delete
        request>headers>X-Playback-Grant delete
        resp_headers>Set-Cookie delete
      }
    }
  }
  @api path /api/*
  handle @api {
    reverse_proxy api:3000 {
      header_up X-Gateway-Token {$API_GATEWAY_TOKEN}
      header_up X-Client-IP {remote_host}
      # The public client cannot supply a trusted internal playback header.
      header_up -X-Playback-Grant
      flush_interval -1
    }
  }
  redir /admin /admin/
  handle {
    reverse_proxy web:80
  }
}
